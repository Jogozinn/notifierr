EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_MARKETPLACE_ID=EBAY_US
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

SQLITE_PATH=backend/data/notifierr.sqlite3
REPAIR_VALUES_PATH=backend/data/repair_values.json
SCORING_RULES_PATH=backend/data/scoring_rules.json

MIN_SCORE_TO_ALERT=70
MIN_PROFIT_TO_ALERT=75
RISKY_SCORE_RANGE=35,69.99
MAX_RESULTS_PER_KEYWORD=25
SEARCH_KEYWORDS=iPhone cracked screen,iPhone broken,iPhone parts only,iPhone back glass cracked,iPhone bad battery,iPhone read description

MAX_ALERT_ITEM_AGE_MINUTES=180
MAX_PRIORITY_REVIEW_ITEM_AGE_HOURS=24
MAX_ACTIVE_QUEUE_ITEM_AGE_HOURS=24
STALE_ARCHIVE_AFTER_DAYS=7

# Optional. Enable a simple non-overlapping background polling loop.
BACKGROUND_POLL_ENABLED=false
BACKGROUND_POLL_SECONDS=300
BACKGROUND_POLL_ACTIVE_START=08:00
BACKGROUND_POLL_ACTIVE_END=23:00
BACKGROUND_POLL_TIMEZONE=America/New_York

# Optional. Uses eBay Browse Item detail calls when enabled; descriptions may not be available for every item.
EBAY_FETCH_DESCRIPTIONS=false
