# Local dev defaults use SQLite and auth disabled.
DB_BACKEND=sqlite
SQLITE_PATH=backend/data/notifierr.sqlite3
AUTH_REQUIRED=false
RESALE_RESEARCH_PATH=backend/data/resale_research.json

# Required for scanning.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_RATE_LIMIT_BACKOFF_SECONDS=900

# Background polling:
# - Local dev starts a lightweight poll supervisor when AUTH_REQUIRED=false.
# - The dashboard/user setting "Background poll enabled" controls whether the
#   local user is actually scanned.
# - Hosted auth-required deployments only start the poll loop when this is true.
BACKGROUND_POLL_ENABLED=false
BACKGROUND_POLL_SECONDS=300
BACKGROUND_POLL_ACTIVE_START=
BACKGROUND_POLL_ACTIVE_END=
BACKGROUND_POLL_TIMEZONE=America/New_York

# Optional local/global Discord fallback when auth is disabled.
# Hosted multi-user deployments should save Discord webhooks per user in the app.
# Check health with GET /admin/polling/status.
# Send a safe test message with POST /admin/notifications/test.
DISCORD_WEBHOOK_URL=

# Hosted Postgres/server example:
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# AUTH_REQUIRED=true
# AUTH_SECRET_KEY=replace-with-a-long-random-secret
# APP_ENCRYPTION_KEY=replace-with-fernet-key
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-strong-password
# ADMIN_DISPLAY_NAME=Admin
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
#
# Warning: do not run BACKGROUND_POLL_ENABLED=true in more than one web worker
# or process. Use one dedicated polling process/worker, or keep it false on web.
